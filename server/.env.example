PORT=5000
MONGO_URI=mongodb://localhost:27017/loc-v1
# Comma-separated list of origins allowed to call this API (no trailing slashes)
CLIENT_ORIGIN=http://localhost:5173,https://lordofcricket.com,https://www.lordofcricket.com
CRICAPI_KEY=

# Postgres (LOC)
PG_USER=
PG_HOST=
PG_DATABASE=
PG_PASSWORD=
PG_PORT=

# Auth — used to sign login sessions (set a long random value in production)
JWT_SECRET=

# Canteen — Cloudinary (for menu item images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ground Booking — the ground's operating policy (all optional, sensible
# defaults in server/src/domain/booking/policy.js if unset)
GROUND_TIMEZONE=Asia/Kolkata
GROUND_OPENING_HOUR=6
GROUND_CLOSING_HOUR=22
GROUND_SLOT_DURATION_MINUTES=120
GROUND_BOOKING_HORIZON_DAYS=60

# Ground Booking — Google Calendar sync (optional; booking works fully
# without it — see docs/ARCHITECTURE.md's Phase 14 section). A SERVICE
# ACCOUNT for the ground's own operational calendar, never a customer's
# personal OAuth. GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY must keep its literal
# "\n" sequences (paste the PEM as one line) — they're unescaped at runtime.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
