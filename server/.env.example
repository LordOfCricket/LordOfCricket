PORT=5000
MONGO_URI=mongodb://localhost:27017/loc-v1
CLIENT_ORIGIN=http://localhost:5173
CRICAPI_KEY=

# Postgres (LOC)
PG_USER=
PG_HOST=
PG_DATABASE=
PG_PASSWORD=
