# Auth — required to self-assign the 'staff' role at signup/role-select.
# Share this only with actual canteen staff. Leave unset to disable staff signup entirely.
STAFF_SIGNUP_CODE=

# Canteen — Cloudinary (for menu item images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
